# Copy to .env, fill in, then: set -a; . ./.env; set +a
# Never commit .env. Never paste the key into an issue, a chat or a screenshot.

# The strategy's API key: Signal Bridge -> Done -> Code -> Your key (Show / Copy),
# or My Strategies -> the strategy's API button.
TT_AUTH_TOKEN=

# Your bridge's symbol variable, exactly as the Links tab shows it (case matters).
TT_SYMBOL=RELIANCE

# Developer API only (developer-api/): a read key from Creator Hub -> Developer API.
TT_DEV_API_KEY=
